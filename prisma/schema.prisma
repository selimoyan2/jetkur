datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// 1. IDENTITY & MULTI-TENANCY FOUNDATION
// Hierarchy: User -> WorkspaceMember -> Workspace -> Sites
// ==========================================

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum PlatformRole {
  NORMAL
  SUPER_ADMIN
}

model User {
  id              String       @id @default(cuid())
  email           String       @unique
  name            String
  passwordHash    String?
  platformRole    PlatformRole @default(NORMAL)
  status          UserStatus   @default(ACTIVE)
  lastLoginAt     DateTime?
  emailVerifiedAt DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  memberships WorkspaceMember[]
  sessions    Session[]

  @@map("users")
}

model Session {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())
  revokedAt  DateTime?
  userAgent  String?
  ipAddress  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("sessions")
}

enum WorkspaceType {
  BUSINESS // Single SME business account
  AGENCY // Multi-client digital agency account
  PLATFORM // Platform internal administration
}

model Workspace {
  id        String        @id @default(cuid())
  name      String
  type      WorkspaceType @default(BUSINESS)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  members              WorkspaceMember[]
  sites                Site[]
  subscriptions        Subscription[]
  entitlementOverrides WorkspaceEntitlementOverride[]

  @@map("workspaces")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@map("workspace_members")
}

// ==========================================
// 1.1 SUBSCRIPTIONS, PLANS & ENTITLEMENTS (Sprint 04)
// Hierarchy: Workspace -> Subscription -> Plan -> PlanEntitlement
// ==========================================

enum PlanStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

model Plan {
  id           String     @id @default(cuid())
  code         String     @unique // Machine identifier: ENTRY, BUSINESS, AGENCY
  name         String // Marketing / display identifier: "Başlangıç", "İşletme", "Ajans"
  description  String?
  status       PlanStatus @default(ACTIVE)
  siteLimit    Int        @default(1)
  trialDays    Int        @default(14)
  monthlyPrice Int? // In minor currency units (e.g. 49900 = 499 TRY)
  yearlyPrice  Int?
  currency     String     @default("TRY")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  subscriptions Subscription[]
  entitlements  PlanEntitlement[]

  @@map("plans")
}

model PlanEntitlement {
  id         String   @id @default(cuid())
  planId     String
  featureKey String // Capability key: "site.blog", "site.customDomain", "agency.whiteLabel"
  enabled    Boolean  @default(true)
  limitValue Int? // Numeric limit: max sites, languages, team members
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, featureKey])
  @@index([featureKey])
  @@map("plan_entitlements")
}

model Subscription {
  id                    String             @id @default(cuid())
  workspaceId           String
  planId                String
  status                SubscriptionStatus @default(TRIALING)
  trialStartsAt         DateTime?
  trialEndsAt           DateTime?
  currentPeriodStartsAt DateTime?
  currentPeriodEndsAt   DateTime?
  cancelAtPeriodEnd     Boolean            @default(false)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plan      Plan      @relation(fields: [planId], references: [id])

  @@index([workspaceId])
  @@index([status])
  @@map("subscriptions")
}

model WorkspaceEntitlementOverride {
  id          String    @id @default(cuid())
  workspaceId String
  featureKey  String
  enabled     Boolean?
  limitValue  Int?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, featureKey])
  @@index([featureKey])
  @@map("workspace_entitlement_overrides")
}

// ==========================================
// 2. CANONICAL SITE ROOT ENTITY
// Invariant: SITE != DEPLOYMENT
// ==========================================

enum SiteStatus {
  DRAFT
  TRIAL
  ACTIVE
  SUSPENDED
  ARCHIVED
}

model Site {
  id             String     @id @default(cuid())
  workspaceId    String
  name           String
  slug           String     @unique
  status         SiteStatus @default(DRAFT)
  schemaVersion  String     @default("1.0.0")
  trialEndsAt    DateTime?
  industryPackId String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  workspace            Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  industryPack         IndustryPack?         @relation(fields: [industryPackId], references: [id])
  businessProfile      BusinessProfile?
  content              SiteContent?
  sectionConfiguration SectionConfiguration?
  settings             SiteSettings?
  domains              Domain[]
  deployments          Deployment[]

  @@index([workspaceId])
  @@index([status])
  @@map("sites")
}

// ==========================================
// 3. CANONICAL DOMAIN ENTITIES (1:1 with Site)
// Pure business, content, design, and settings
// ==========================================

model BusinessProfile {
  id           String   @id @default(cuid())
  siteId       String   @unique
  companyName  String
  sector       String
  slogan       String?
  phone        String?
  email        String?
  whatsapp     String?
  address      String?
  city         String?
  workingHours Json?
  branding     Json?
  services     Json?
  serviceAreas Json?
  social       Json?
  legal        Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@map("business_profiles")
}

model SiteContent {
  id              String   @id @default(cuid())
  siteId          String   @unique
  hero            Json?
  about           Json?
  whyUs           Json?
  gallery         Json?
  testimonials    Json?
  faqs            Json?
  pricingPlans    Json?
  blogPosts       Json?
  catalogProducts Json?
  customPages     Json?
  announcement    Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@map("site_contents")
}

model SectionConfiguration {
  id        String   @id @default(cuid())
  siteId    String   @unique
  sections  Json // Ordered array of HomepageSectionConfig
  header    Json? // HeaderConfig
  footer    Json? // FooterConfig
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@map("section_configurations")
}

model SiteSettings {
  id             String   @id @default(cuid())
  siteId         String   @unique
  structureMode  String   @default("single-page")
  seo            Json? // TechnicalSeoConfig
  analytics      Json? // AnalyticsIntegrations
  whatsappWidget Json? // WhatsAppFloatingWidgetConfig
  leads          Json? // LeadHandlingConfig
  performance    Json? // PerformancePreferences
  locale         Json? // LocaleSettings
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@map("site_settings")
}

// ==========================================
// 4. INFRASTRUCTURE & LIFECYCLE (SITE != DEPLOYMENT)
// Standalone relational infrastructure tracking
// ==========================================

enum DomainStatus {
  PENDING_DNS
  VERIFYING
  ACTIVE
  ERROR
}

model Domain {
  id         String       @id @default(cuid())
  siteId     String
  hostname   String       @unique
  isCustom   Boolean      @default(true)
  isPrimary  Boolean      @default(false)
  status     DomainStatus @default(PENDING_DNS)
  sslActive  Boolean      @default(false)
  dnsRecords Json? // Array of { type, name, value }
  verifiedAt DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
  @@map("domains")
}

enum DeploymentProvider {
  CLOUDFLARE_PAGES
  EDGE_CDN
  SELF_HOSTED
  VERCEL
  NETLIFY
}

enum DeploymentStatus {
  IDLE
  BUILDING
  DEPLOYED
  ERROR
  CANCELLED
}

model Deployment {
  id            String             @id @default(cuid())
  siteId        String
  provider      DeploymentProvider @default(CLOUDFLARE_PAGES)
  status        DeploymentStatus   @default(IDLE)
  productionUrl String?
  previewUrl    String?
  deploymentId  String? // External Cloudflare / provider deployment ID
  buildTimeMs   Int?
  commitHash    String?
  logs          String?
  metadata      Json?
  deployedAt    DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
  @@index([status])
  @@map("deployments")
}

// ==========================================
// 5. INDUSTRY PACKS & DESIGN TEMPLATES CATALOG
// System-level reusable sectoral packs & theme definitions
// ==========================================

model IndustryPack {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  sector      String
  version     String   @default("1.0.0")
  description String?
  starterData Json // Default services, faqs, copy presets, image intents
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sites Site[]

  @@map("industry_packs")
}

model DesignTemplate {
  id                String   @id @default(cuid())
  slug              String   @unique
  name              String
  category          String   @default("general")
  previewImage      String?
  defaultTokens     Json // Palette, typography, geometry
  supportedVariants Json // Supported layout variants
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("design_templates")
}
